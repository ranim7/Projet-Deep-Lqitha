@echo off
title Lqitha - Step 4 - Evaluations
cd /d "%~dp0"
call scripts\_env.bat || exit /b 1
set LQITHA_NO_LOCAL_FALLBACK=1
echo Results go to reports\results\ (JSON + Markdown). LLM calls are cached: re-running is fast and free.
echo [1/8] Retrieval (RAG) evaluation...
"%PY%" scripts\eval_rag.py > logs\eval_rag.log 2>&1
echo [2/8] Speech-to-text evaluation (Tunisian Derja)...
"%PY%" scripts\eval_stt.py > logs\eval_stt.log 2>&1
echo [3/8] Prompt evaluation v1 vs v2 (several minutes, API rate limits)...
"%PY%" scripts\eval_prompts.py > logs\eval_prompts.log 2>&1
echo [4/8] Matching + verifier evaluation...
"%PY%" scripts\eval_matching.py > logs\eval_matching.log 2>&1
echo [5/8] Seeding the demo database...
"%PY%" scripts\seed_demo.py > logs\seed_demo.log 2>&1
echo [6/8] Agentic RAG (recovery plan) vs single-query RAG...
"%PY%" scripts\eval_agentic_rag.py > logs\eval_agentic_rag.log 2>&1
echo [7/8] Found-items search (multimodal RAG over the database)...
"%PY%" scripts\eval_search.py > logs\eval_search.log 2>&1
echo [8/8] Board translator: BLEU / ROUGE by round-trip translation...
"%PY%" scripts\eval_translation.py > logs\eval_translation.log 2>&1
echo Done.
timeout /t 15
